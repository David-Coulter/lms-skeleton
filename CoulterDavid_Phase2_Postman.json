    {
      "name": "3 \u00b7 User registration",
      "description": "Self-service sign-up. Public endpoint - you cannot have a token before you have an account.",
      "item": [
        {
          "name": "Register a new account (no token)",
          "request": {
            "method": "POST",
            "description": "Creates the Keycloak account and the profile row in one call. The role is forced to 'student' server-side: the request body cannot ask for admin.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newstudent\",\n  \"email\": \"newstudent@learninghub.local\",\n  \"firstName\": \"New\",\n  \"lastName\": \"Student\",\n  \"password\": \"newpass123\",\n  \"gradeLevel\": \"junior\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/users/register",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "users",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('profile row created', () => pm.expect(b.username).to.eql('newstudent'));",
                  "pm.test('role forced to student', () => pm.expect(b.role).to.eql('student'));",
                  "if (b.id) pm.collectionVariables.set('newProfileId', b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register the same username again \u2192 409",
          "request": {
            "method": "POST",
            "description": "Keycloak already has the account, so registration is refused.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newstudent\",\n  \"email\": \"newstudent@learninghub.local\",\n  \"firstName\": \"New\",\n  \"lastName\": \"Student\",\n  \"password\": \"newpass123\",\n  \"gradeLevel\": \"junior\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/users/register",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "users",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as the account we just created",
          "request": {
            "method": "POST",
            "description": "Proof the registration actually reached Keycloak: the new account can authenticate.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "learninghub-spa"
                },
                {
                  "key": "username",
                  "value": "newstudent"
                },
                {
                  "key": "password",
                  "value": "newpass123"
                }
              ]
            },
            "url": {
              "raw": "{{gatewayUrl}}/auth/realms/learninghub/protocol/openid-connect/token",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "realms",
                "learninghub",
                "protocol",
                "openid-connect",
                "token"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 - Keycloak issued a token', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('got an access_token', () => pm.expect(b.access_token).to.be.a('string'));",
                  "pm.collectionVariables.set('newUserToken', b.access_token);",
                  "// decode the payload so the roles are visible in the console during the demo",
                  "const payload = JSON.parse(atob(b.access_token.split('.')[1]));",
                  "console.log('user:', payload.preferred_username, '| roles:', payload.realm_access.roles.join(', '));",
                  "console.log('issuer:', payload.iss);",
                  "pm.test('token carries realm roles', () => pm.expect(payload.realm_access.roles).to.be.an('array'));"
                ]
              }
            }
          ]
