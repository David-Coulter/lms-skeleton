    {
      "name": "2 \u00b7 Authorization",
      "description": "Same endpoints, three different tokens. The role in the token decides what comes back.",
      "item": [
        {
          "name": "Student \u2192 /teachers \u2192 200",
          "request": {
            "method": "GET",
            "description": "Any signed-in user may see who teaches. @PreAuthorize(\"isAuthenticated()\")",
            "url": {
              "raw": "{{gatewayUrl}}/api/users/teachers",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "users",
                "teachers"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 - students may list teachers', () => pm.response.to.have.status(200));",
                  "pm.test('only teachers come back', () => pm.response.json().forEach(p => pm.expect(p.role).to.eql('teacher')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Student \u2192 /directory \u2192 403",
          "request": {
            "method": "GET",
            "description": "The directory is staff-only: students do not browse other students. The token is valid - this is authorization failing, not authentication. @PreAuthorize(\"hasAnyRole('TEACHER','ADMIN')\")",
            "url": {
              "raw": "{{gatewayUrl}}/api/users/directory",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "users",
                "directory"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden - valid token, wrong role', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
