    {
      "name": "4 \u00b7 Password reminder",
      "description": "Triggers Keycloak's reset-password email. Check the MailHog inbox at http://localhost:8025.",
      "item": [
        {
          "name": "Request a reminder for student1",
          "request": {
            "method": "POST",
            "description": "Keycloak emails an 'update password' action link. The mail lands in MailHog at http://localhost:8025 - open it during the demo.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"student1\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/users/password-reminder",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "users",
                "password-reminder"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "console.log('Now open http://localhost:8025 - the reset email should be there.');"
                ]
              }
            }
          ]
        },
        {
          "name": "Request a reminder for an account that does not exist \u2192 still 202",
          "request": {
            "method": "POST",
            "description": "Deliberately the SAME response as a real account. Returning 404 here would turn this endpoint into a username oracle - anyone could discover which accounts exist. No email is sent; the miss is logged server-side.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"no-such-person\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/users/password-reminder",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "users",
                "password-reminder"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 - identical to the real case', () => pm.response.to.have.status(202));",
                  "pm.test('response body gives nothing away', () => pm.expect(pm.response.text()).to.include('If that account exists'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5 \u00b7 Bearer token across services",
      "description": "One token, issued once, accepted everywhere. Nothing stores a session.",
      "item": [
        {
          "name": "Same student token, call 1 of 2",
          "request": {
            "method": "GET",
            "description": "The gateway forwards the Authorization header untouched; user-service verifies the signature against the realm's JWKS. The gateway never validates the token itself, so a service is still safe if something reaches it directly.",
            "url": {
              "raw": "{{gatewayUrl}}/api/users/teachers",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "users",
                "teachers"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Same student token, call 2 of 2",
          "request": {
            "method": "GET",
            "description": "Same token, different endpoint, no re-authentication and no session on the server. That statelessness is what lets user-service run as several instances.",
            "url": {
              "raw": "{{gatewayUrl}}/api/users/profiles/whoami",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "users",
                "profiles",
                "whoami"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "console.log('environment:', pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "Tampered token \u2192 401",
          "request": {
            "method": "GET",
            "description": "Flip one character in the signature. The service rejects it without asking Keycloak anything - the signature alone is proof.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}x"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/users/teachers",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "users",
                "teachers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 - bad signature', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}